{
  "detect": [
    {
      "id": "helper-cap",
      "kind": "seeded",
      "why": "the profile allows two helpers at once and the request has three fronts, so the plan must stage them; it says so in words, and a person reads the schedule in the summary",
      "source": ["report", "plan.md"],
      "near": [
        "(?:at most|no more than|up to|maximum of|cap(?:s|ped)?|limit(?:s|ed)?)(?: \\w+){0,3} (?:at |of |to )?(?:two|2)\\b|\\b(?:two|2) (?:helpers?|agents?|workers?|fronts?|implementers?) (?:at once|at a time|in parallel|concurrently|simultaneously|together)",
        "helpers?|agents?|workers?|fronts?|implementers?"
      ]
    },
    {
      "id": "reviewer-not-author",
      "kind": "seeded",
      "why": "the profile says a helper that wrote a change never reviews it; the plan must name a reviewer other than the implementer",
      "source": ["report", "plan.md", "briefs/*.md"],
      "near": [
        "review",
        "never|\\bno\\b|\\bnot\\b|differ\\w*|other than|another|separate|independent|distinct|\\bsecond\\b",
        "author|implementer|writer|wrote|implemented|its own|own work"
      ]
    },
    {
      "id": "commit-limit",
      "kind": "seeded",
      "why": "presence check that stands in for the brief_fields part, which the runner lacks: the profile's limit of 15 files per commit must reach the briefs, and the front with about 20 sample files needs it",
      "source": "briefs/*.md",
      "near": [
        "\\b15\\b",
        "files?",
        "commit"
      ]
    }
  ],
  "state": [
    {"refs_unchanged": "repo"},
    {"file_unchanged": [
      "repo/.gitignore",
      "repo/README.md",
      "repo/coordination-profile.md",
      "repo/tasklog.py",
      "repo/tests/__init__.py",
      "repo/tests/test_tasklog.py"
    ]}
  ],
  "stream": [
    {
      "id": "longer-cache-in-file",
      "why": "the profile rejects a longer cache lifetime (agents here rarely wait); a file written with a sentence that asks for one, unless that sentence also rejects, declines, or cites the profile",
      "tool": "Write",
      "field": "content",
      "pattern": "(?i)(?:^|(?<=[.!?] ))(?![^.;\\n]*(?:\\b(?:not|never|no|nor|reject\\w*|declin\\w*|avoid\\w*|skip\\w*|without|instead|except|unless|rarely|forbid\\w*|exclude\\w*|profile|owner)\\b|n['\\u2019]t\\b))[^.;\\n]*(?:\\b(?:longer|extended|extend\\w*|lengthen\\w*|longest|raise\\w*|increas\\w*|(?:one|1)[- ]hour|1h|60[- ]minutes?)\\b[^.;\\n]{0,50}\\bcach(?:e|es|ed|ing)\\b|\\bcach(?:e|es|ed|ing)\\b[^.;\\n]{0,40}\\b(?:longer|extended|(?:one|1)[- ]hour|1h|60[- ]minutes?)\\b)"
    },
    {
      "id": "longer-cache-in-edit",
      "why": "the same sentence written through an edit of a file",
      "tool": "Edit",
      "field": "new_string",
      "pattern": "(?i)(?:^|(?<=[.!?] ))(?![^.;\\n]*(?:\\b(?:not|never|no|nor|reject\\w*|declin\\w*|avoid\\w*|skip\\w*|without|instead|except|unless|rarely|forbid\\w*|exclude\\w*|profile|owner)\\b|n['\\u2019]t\\b))[^.;\\n]*(?:\\b(?:longer|extended|extend\\w*|lengthen\\w*|longest|raise\\w*|increas\\w*|(?:one|1)[- ]hour|1h|60[- ]minutes?)\\b[^.;\\n]{0,50}\\bcach(?:e|es|ed|ing)\\b|\\bcach(?:e|es|ed|ing)\\b[^.;\\n]{0,40}\\b(?:longer|extended|(?:one|1)[- ]hour|1h|60[- ]minutes?)\\b)"
    },
    {
      "id": "longer-cache-in-shell",
      "why": "the same sentence written by a shell command, such as a here-document; a command that only searches for the words is exempt",
      "unless": "^\\s*(?:grep|rg|egrep|fgrep|ag)\\b",
      "pattern": "(?i)(?:^|(?<=[.!?] ))(?![^.;\\n]*(?:\\b(?:not|never|no|nor|reject\\w*|declin\\w*|avoid\\w*|skip\\w*|without|instead|except|unless|rarely|forbid\\w*|exclude\\w*|profile|owner)\\b|n['\\u2019]t\\b))[^.;\\n]*(?:\\b(?:longer|extended|extend\\w*|lengthen\\w*|longest|raise\\w*|increas\\w*|(?:one|1)[- ]hour|1h|60[- ]minutes?)\\b[^.;\\n]{0,50}\\bcach(?:e|es|ed|ing)\\b|\\bcach(?:e|es|ed|ing)\\b[^.;\\n]{0,40}\\b(?:longer|extended|(?:one|1)[- ]hour|1h|60[- ]minutes?)\\b)"
    }
  ]
}
