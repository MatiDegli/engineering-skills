    },
    {
      "id": "longer-cache-in-edit",
      "why": "the same sentence written through an edit of a file",
      "tool": "Edit",
      "field": "new_string",
      "pattern": "(?i)(?:\\A|(?<=\\n\\n)|(?<=[.!?:;]\\n)|(?<=\\n)(?=[ \\t]*(?:[-*+]\\s|\\d+[.)]\\s|\\||#))|(?<=[.!?;][ \\t]))(?=(?:(?:[^\\n.!?;]|[.!?;](?!\\s|\\Z)|\\n(?![ \\t]*(?:\\n|[-*+]\\s|\\d+[.)]\\s|\\||#)))){0,400}?(?:\\b(?:longer|extend\\w*|lengthen\\w*|longest|long[- ]lived|long[- ]living|long[- ]term|rais\\w+|increas\\w*|bump\\w*|boost\\w*|(?:one|1|an)[- ]hours?|1h|60[- ]?min\\w*|3600(?:\\s*s\\w*)?|hour[- ]long)\\b(?:(?:[^\\n.!?;]|[.!?;](?!\\s|\\Z)|\\n(?![ \\t]*(?:\\n|[-*+]\\s|\\d+[.)]\\s|\\||#)))){0,50}?\\bcach(?:e|es|ed|ing)\\b|\\bcach(?:e|es|ed|ing)\\b(?:(?:[^\\n.!?;]|[.!?;](?!\\s|\\Z)|\\n(?![ \\t]*(?:\\n|[-*+]\\s|\\d+[.)]\\s|\\||#)))){0,40}?\\b(?:longer|extend\\w*|(?:one|1|an)[- ]hours?|1h|60[- ]?min\\w*|3600)\\b))(?!(?:(?:[^\\n.!?;]|[.!?;](?!\\s|\\Z)|\\n(?![ \\t]*(?:\\n|[-*+]\\s|\\d+[.)]\\s|\\||#)))){0,400}?(?:\\bnot\\b|\\bnever\\b|\\bno\\b|\\bnor\\b|\\bneither\\b|\\bnone\\b|\\bwithout\\b|\\bcannot\\b|n['’]t\\b|\\breject\\w*|\\bdeclin\\w*|\\bavoid\\w*|\\bskip\\w*|\\bforg[oe]\\w*|\\bforbid\\w*|\\bexclud\\w*|\\bagainst\\b|\\bout of scope\\b|\\brul(?:e|ed|es|ing) out\\b|\\bn/a\\b|\\boff\\b|\\bdisabl\\w*|\\bdisallow\\w*|\\bprohibit\\w*))(?!(?:(?:[^\\n]|(?<![.!?:;])\\n(?![ \\t]*(?:\\n|[-*+]\\s|\\d+[.)]\\s|\\||#)))){0,400}?(?:\\breject\\w*|\\bdeclin\\w*|\\bn/a\\b|\\bnot (?:adopted|applicable|used|needed|applied|enabled)\\b|\\boff\\b|\\bdisabl\\w*|\\brul(?:e|ed|es|ing) out\\b|\\bskipp?ed\\b|\\bout of scope\\b|\\b(?:they|it|we|that|this)\\s+(?:do|does|did|will|would|can|could)(?:\\s+not|n['’]t)\\b))"
    },
    {
      "id": "longer-cache-in-shell",
      "why": "the same sentence written by a shell command, such as a here-document; a command that only searches for the words is exempt",
      "unless": "\\A\\s*(?:grep|rg|egrep|fgrep|ag)\\b(?:[^;&\\n<]|2>&1)*\\Z",
      "pattern": "(?i)(?:\\A|(?<=\\n\\n)|(?<=[.!?:;]\\n)|(?<=\\n)(?=[ \\t]*(?:[-*+]\\s|\\d+[.)]\\s|\\||#))|(?<=[.!?;][ \\t]))(?=(?:(?:[^\\n.!?;]|[.!?;](?!\\s|\\Z)|\\n(?![ \\t]*(?:\\n|[-*+]\\s|\\d+[.)]\\s|\\||#)))){0,400}?(?:\\b(?:longer|extend\\w*|lengthen\\w*|longest|long[- ]lived|long[- ]living|long[- ]term|rais\\w+|increas\\w*|bump\\w*|boost\\w*|(?:one|1|an)[- ]hours?|1h|60[- ]?min\\w*|3600(?:\\s*s\\w*)?|hour[- ]long)\\b(?:(?:[^\\n.!?;]|[.!?;](?!\\s|\\Z)|\\n(?![ \\t]*(?:\\n|[-*+]\\s|\\d+[.)]\\s|\\||#)))){0,50}?\\bcach(?:e|es|ed|ing)\\b|\\bcach(?:e|es|ed|ing)\\b(?:(?:[^\\n.!?;]|[.!?;](?!\\s|\\Z)|\\n(?![ \\t]*(?:\\n|[-*+]\\s|\\d+[.)]\\s|\\||#)))){0,40}?\\b(?:longer|extend\\w*|(?:one|1|an)[- ]hours?|1h|60[- ]?min\\w*|3600)\\b))(?!(?:(?:[^\\n.!?;]|[.!?;](?!\\s|\\Z)|\\n(?![ \\t]*(?:\\n|[-*+]\\s|\\d+[.)]\\s|\\||#)))){0,400}?(?:\\bnot\\b|\\bnever\\b|\\bno\\b|\\bnor\\b|\\bneither\\b|\\bnone\\b|\\bwithout\\b|\\bcannot\\b|n['’]t\\b|\\breject\\w*|\\bdeclin\\w*|\\bavoid\\w*|\\bskip\\w*|\\bforg[oe]\\w*|\\bforbid\\w*|\\bexclud\\w*|\\bagainst\\b|\\bout of scope\\b|\\brul(?:e|ed|es|ing) out\\b|\\bn/a\\b|\\boff\\b|\\bdisabl\\w*|\\bdisallow\\w*|\\bprohibit\\w*))(?!(?:(?:[^\\n]|(?<![.!?:;])\\n(?![ \\t]*(?:\\n|[-*+]\\s|\\d+[.)]\\s|\\||#)))){0,400}?(?:\\breject\\w*|\\bdeclin\\w*|\\bn/a\\b|\\bnot (?:adopted|applicable|used|needed|applied|enabled)\\b|\\boff\\b|\\bdisabl\\w*|\\brul(?:e|ed|es|ing) out\\b|\\bskipp?ed\\b|\\bout of scope\\b|\\b(?:they|it|we|that|this)\\s+(?:do|does|did|will|would|can|could)(?:\\s+not|n['’]t)\\b))"
    }
  ]
