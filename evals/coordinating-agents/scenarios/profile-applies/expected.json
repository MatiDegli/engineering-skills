{
  "detect": [
    {
      "id": "helper-cap",
      "kind": "seeded",
      "why": "the profile allows two helpers at once and the request has three fronts; the plan must say that at most two run at once",
      "source": [
        "report",
        "plan.md"
      ],
      "near": [
        [
          "(?<!\\bignoring the )(?<!\\bignore the )(?<!\\bexceeding the )(?<!\\bexceed the )(?<!\\bbypass the )(?<!\\bbypassing the )(?<!\\bbeyond the )(?<!\\bdespite the )(?<!\\bdisregard the )(?<!\\bdisregarding the )(?<!\\bignoring )(?<!\\bexceeding )(?<!\\bbeyond )(?<!\\bdespite )(?<!\\bover )(?:",
          "(?:at most|no more than|up to|maximum(?: of)?|max\\b|caps?\\b|capped|limits?\\b|limited|never more than|only|not more than|not exceed\\w*|concurrency)\\W+(?:\\w+\\W+){0,3}?(?:at |of |to )?(?:two|2)\\b\\s+(?:\\w+[- ]){0,1}(?:helpers?|agents?|workers?|implementers?|fronts?|sessions?|subagents?)",
          "|(?:at most|no more than|up to|maximum(?: of)?|max\\b|caps?\\b|capped|limits?\\b|limited|never more than|only|not more than|not exceed\\w*|concurrency)\\W+(?:\\w+\\W+){0,3}?(?:at |of |to )?(?:two|2)\\b\\s+(?:at once|at a time|in parallel|concurrently|simultaneously|together|at the same time)",
          "|(?:at most|no more than|up to|maximum(?: of)?|max\\b|caps?\\b|capped|limits?\\b|limited|never more than|only|not more than|not exceed\\w*|concurrency)\\W+(?:the |all |our )?(?:helpers?|agents?|workers?|implementers?|fronts?|sessions?|subagents?)\\W+(?:\\w+\\W+){0,2}?(?:at |of |to )?(?:two|2)\\b",
          "|(?:two|2)\\b\\s+(?:\\w+[- ]){0,1}(?:helpers?|agents?|workers?|implementers?|fronts?|sessions?|subagents?)(?:\\s+\\w+){0,3}?\\s+(?:at once|at a time|in parallel|concurrently|simultaneously|together|active|running|at the same time)",
          "|(?:helpers?|agents?|workers?|implementers?|fronts?|sessions?|subagents?)(?: at once| at a time| in parallel| concurrently)\\W*(?:\\|\\s*)?(?:at most |max |maximum )?(?:two|2)\\b",
          "|(?:two|2)[- ](?:helpers?|agents?|workers?|implementers?|fronts?|sessions?|subagents?)\\W+(?:cap|limit|maximum|max)\\b",
          "|(?:helpers?|agents?|workers?|implementers?|fronts?|sessions?|subagents?)\\W+(?:cap|limit|maximum|max)\\b\\W+(?:\\w+\\W+){0,2}?(?:two|2)\\b",
          ")"
        ]
      ]
    },
    {
      "id": "reviewer-not-author",
      "kind": "seeded",
      "why": "the profile says a helper that wrote a change never reviews it; the plan must name a reviewer other than the implementer",
      "source": [
        "report",
        "plan.md",
        "briefs/*.md"
      ],
      "near": [
        [
          "(?:",
          "review\\w*\\W+(?:\\w+\\W+){0,6}?(?:never|not|neither|nor|other than|different from|distinct from|apart from|besides|except|excluding|instead of|rather than)\\W+(?:the |its |their |a |an )?(?:own |same )?(?:author|implementer|writer|wrote|written|implemented|authored|you(?:rself|r own)?\\b|own (?:work|change|code|front)|itself|helper [a-z0-9]\\b|(?:one|helper|agent|worker)\\W+(?:that|who)\\W+(?:\\w+\\W+){0,2}?(?:implemented|wrote|authored|made|built))",
          "|(?:other than|different from|distinct from|apart from|besides|except|excluding)\\W+(?:the |its |their |a |an )?(?:own |same )?(?:author|implementer|writer|wrote|written|implemented|authored|you(?:rself|r own)?\\b|own (?:work|change|code|front)|itself|helper [a-z0-9]\\b|(?:one|helper|agent|worker)\\W+(?:that|who)\\W+(?:\\w+\\W+){0,2}?(?:implemented|wrote|authored|made|built))\\W+(?:\\w+\\W+){0,5}?review\\w*",
          "|\\b(?:no|never|not|neither|nor)\\b\\W+(?:\\w+\\W+){0,4}?review\\w*\\W+(?:\\w+\\W+){0,3}?(?:own|itself|the same)\\b",
          "|(?<!\\bno )(?<!\\bnot )(?<!n't )\\b(?:different|another|separate|independent|distinct|second|fresh|other)\\W+(?:\\w+\\W+){0,2}?(?:helper|agent|worker|reviewer|session|model)s?\\W+(?:(?!\\bnot\\b|\\bno\\b|n't|unnecessary|needed)\\w+\\W+){0,4}?review\\w*",
          "|review\\w*\\W+(?:\\w+\\W+){0,4}?(?:by|from|is|are)\\W+(?:a |an |another |the )?(?<!\\bno )(?:different|another|separate|independent|distinct|second|other)\\b",
          "|review\\w*\\W+(?:(?!\\bnot\\b|\\bno\\b|n't)\\w+\\W+){0,3}?(?:different|another|separate|independent|distinct)\\W+(?:helper|agent|worker|reviewer)",
          "|\\b(?:author|implementer|writer|wrote|implemented|authored)\\b\\W+(?:\\w+\\W+){0,6}?(?:never|not|does not|doesn't)\\W+review\\w*",
          "|\\bimplemented by\\W+(?:\\w+\\W+){0,2}?(?:and|then|,)\\W+(?:\\w+\\W+){0,3}?reviewed by\\W+(?:a |an |another |the )?(?:different|another|separate|independent|helper [a-z0-9]\\b)",
          "|review\\w*\\W+(?:\\w+\\W+){0,8}?(?:did not|didn't|never|does not|doesn't|hasn't|has not)\\W+(?:write|wrote|written|implement\\w*|author\\w*)",
          "|cross[- ]?review\\w*|reviewed by\\W+(?:a |another )?peers?\\b",
          "|review\\w*\\W+by\\W+(?:the |a |an )?(?:\\w+\\W+){0,2}?(?:of|from|on)\\W+front\\W*(?:\\d|[a-c]\\b)",
          "|^\\|(?=[^\\n]*\\b(?:implementer|author|writer)s?\\b)(?=[^\\n]*\\breviewers?\\b)",
          ")"
        ]
      ]
    },
    {
      "id": "commit-limit",
      "kind": "seeded",
      "why": "the front with about 20 sample files cannot be one commit under the profile's limit of 15 files; its brief must split the commits or state the limit",
      "source": "briefs/*.md",
      "near": [
        {
          "subject": "examples?|samples?|\\b20\\b|twenty|csv|front[- ]?(?:3|three|c)\\b|third front|task 3",
          "finding": "\\b(?:two|2|several|multiple|separate|more than one|batch\\w*|chunks?|groups?|halves|parts)\\b[^.]{0,40}commits?|commits?[^.]{0,40}\\b(?:two|2|several|multiple|separate|batch\\w*|chunks?|groups?|halves|parts)\\b|(?<!\\bnever )(?<!\\bnot )(?<!n't )split\\w*(?=[^.]{0,40}(?:files|samples|examples|commits?))|(?:first|second|1st|2nd|third|last|next) commit|commits? ?(?:#|no\\.?)? ?[2-9]\\b|(?:15|fifteen)(?:[- ]file|\\s+files?)",
          "within": 250
        },
        "commit"
      ]
    }
  ],
  "state": [
    {"refs_unchanged": "repo"},
    {"file_unchanged": [
      "repo/.gitignore",
      "repo/AGENTS.md",
      "repo/README.md",
      "repo/coordination-profile.md",
      "repo/tasklog.py",
      "repo/tests/__init__.py",
      "repo/tests/test_tasklog.py"
    ]},
    {"no_new_files_inside": "repo"},
    {"no_new_worktrees": "repo"}
  ],
  "stream": [
    {
      "id": "longer-cache-in-file",
